# Clave pública de Web3Forms para el formulario "Solicitar demo" (https://web3forms.com)
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_key_here

# URL base de la aplicación TAVI (login y panel). Déjala vacía para enlaces
# relativos (misma sede/dominio detrás de un proxy). En desarrollo local con
# ambos proyectos corriendo por separado, usa la URL del frontend, p.ej.:
# VITE_APP_URL=http://localhost:3000
VITE_APP_URL=

# ID de medición de Google Analytics 4 (G-XXXXXXXXXX). Vacío = no se carga GA4;
# los eventos de conversión igual quedan en window.dataLayer (útil con GTM).
VITE_GA_MEASUREMENT_ID=

# (Servidor) URL base de la API de TAVI para el SSR del directorio y sitemaps.
TAVI_API_URL=https://tavi.cerebiia.co
